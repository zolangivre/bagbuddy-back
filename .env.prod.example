# Configuration de production pour docker-compose.prod.yml -- copier en .env.prod SUR LA VM
# uniquement, jamais dans le depot (.env.* est ignore par git).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Toute valeur secrete se genere avec : openssl rand -hex 32
# (hexadecimal : aucun caractere que docker compose ou une URL interpreteraient).

# DOMAINES
# ======================================= #
# Deux noms qui pointent sur l'IP publique de la VM (ex. deux sous-domaines DuckDNS).
# Caddy obtient leurs certificats HTTPS tout seul au premier demarrage.
API_DOMAIN=api-bagbuddy.duckdns.org
AUTH_DOMAIN=auth-bagbuddy.duckdns.org

# URL exacte du front web en production, sans slash final. Sert a la fois au CORS de la
# gateway et aux redirect URIs / web origins du client Keycloak bagbuddy-web.
BAGBUDDY_FRONT_URL=https://bagbuddy.pages.dev
# ======================================= #

# POSTGRES (une instance, une base par service)
# ======================================= #
# Mot de passe du super-utilisateur 'postgres' : sert aux sauvegardes, pas aux services.
POSTGRES_PASSWORD=

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

TRIP_SERVICE_DB=tripservice
TRIP_SERVICE_USER=tripservice
TRIP_SERVICE_PASSWORD=

TRANSACTION_SERVICE_DB=transactionservice
TRANSACTION_SERVICE_USER=transactionservice
TRANSACTION_SERVICE_PASSWORD=

REVIEW_SERVICE_DB=reviewservice
REVIEW_SERVICE_USER=reviewservice
REVIEW_SERVICE_PASSWORD=

USER_SERVICE_DB=userservice
USER_SERVICE_USER=userservice
USER_SERVICE_PASSWORD=
# ======================================= #

# KEYCLOAK
# ======================================= #
# Compte administrateur du realm master, cree au premier demarrage uniquement.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Secrets des clients confidentiels, injectes dans le realm a son import. Differents de
# ceux du dev, et differents l'un de l'autre (voir .env.example pour leur role).
KEYCLOAK_SERVICE_CLIENT_SECRET=
KEYCLOAK_ACCOUNTS_CLIENT_SECRET=
# ======================================= #

# EMAILS DE COMPTE (userservice)
# ======================================= #
# Serveur SMTP en STARTTLS (port 587) pour le mot de passe oublie : Brevo, Mailjet, Resend,
# Postmark... L'adresse d'expedition doit appartenir a un domaine verifie chez ce fournisseur,
# sinon les emails finissent en spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=BagBuddy <no-reply@example.com>
# ======================================= #

# STRIPE
# ======================================= #
# Cles du dashboard Stripe (sk_test_/pk_test_ tant que l'app n'encaisse pas de vrais paiements).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de l'endpoint webhook https://<API_DOMAIN>/stripe/webhook cree dans le dashboard
# Stripe (Developpeurs > Webhooks), evenement payment_intent.succeeded.
STRIPE_WEBHOOK_SECRET=
# ======================================= #

# SUPERVISION (optionnelle, --profile monitoring)
# ======================================= #
# Mot de passe du compte admin de Grafana (http://localhost:3000 par tunnel SSH). Vide, Grafana
# demarre avec admin/admin et exige de le changer a la premiere connexion.
GRAFANA_ADMIN_PASSWORD=
# ======================================= #
