# Local dev credentials for docker-compose.dev.yml — copy to .env and fill in.
# These are only used by local Postgres/Keycloak containers, never sent anywhere external.
# Production uses its own file: see .env.prod.example.

# API GATEWAY
# ======================================= #
# Origines autorisees par le CORS de la gateway (front web Angular).
# Plusieurs valeurs possibles, separees par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL du front injectee dans le client Keycloak bagbuddy-web (redirect URIs, web origins)
# a l'import du realm. Defaut : http://localhost:4200.
# BAGBUDDY_FRONT_URL=http://localhost:4200
# ======================================= #

# KEYCLOAK
# ======================================= #
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
# ======================================= #

# TRIP_SERVICE_DB
# ======================================= #
TRIP_SERVICE_DB=tripservice
TRIP_SERVICE_USER=tripservice
TRIP_SERVICE_PASSWORD=
TRIP_SERVICE_DB_PORT=5440
# ======================================= #

# TRANSACTION_SERVICE_DB
# ======================================= #
TRANSACTION_SERVICE_DB=transactionservice
TRANSACTION_SERVICE_USER=transactionservice
TRANSACTION_SERVICE_PASSWORD=
TRANSACTION_SERVICE_DB_PORT=5441
# ======================================= #

# REVIEW_SERVICE_DB
# ======================================= #
REVIEW_SERVICE_DB=reviewservice
REVIEW_SERVICE_USER=reviewservice
REVIEW_SERVICE_PASSWORD=
REVIEW_SERVICE_DB_PORT=5442
# ======================================= #

# USER_SERVICE_DB
# ======================================= #
USER_SERVICE_DB=userservice
USER_SERVICE_USER=userservice
USER_SERVICE_PASSWORD=
USER_SERVICE_DB_PORT=5443
# ======================================= #

# SERVICE-A-SERVICE (Keycloak)
# ======================================= #
# Secret du client confidentiel `bagbuddy`, utilise pour les appels machine-a-machine
# (tarification d'une reservation, confirmation de paiement Stripe). Genere une valeur
# aleatoire : `openssl rand -base64 32`. Elle est injectee dans Keycloak a l'import du
# realm ET lue par transactionservice / stripeservice.
KEYCLOAK_SERVICE_CLIENT_SECRET=

# Secret du client confidentiel `bagbuddy-accounts`, utilise par userservice pour l'API
# d'administration de Keycloak (inscription, changement d'email, mot de passe). Secret
# distinct du precedent : ces droits ne doivent pas etre portes par le client de
# tarification. `openssl rand -base64 32`.
KEYCLOAK_ACCOUNTS_CLIENT_SECRET=
# ======================================= #

# STRIPE
# ======================================= #
# Cles de TEST du dashboard Stripe (Developpeurs > Cles API). Tant que STRIPE_SECRET_KEY
# est vide, stripe-service refuse de demarrer ; le reste de la stack fonctionne.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secret de signature des webhooks. En local, c'est celui qu'affiche le Stripe CLI (voir
# README, "Payer en local").
STRIPE_WEBHOOK_SECRET=

# true (defaut) : une transaction ne passe "confirmed" qu'une fois le paiement confirme
# par le webhook Stripe. false : le paiement est simule, pratique sans cles Stripe.
PAYMENTS_REQUIRE_STRIPE=true
# ======================================= #
